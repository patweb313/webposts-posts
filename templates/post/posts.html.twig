{% extends 'base.html.twig' %}

{% block title %}WebPosts{% endblock %}

{% block body %}
{# All posts #}
<section class="mx-auto max-w-7xl py-12 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-light tracking-tight sm:text-4xl pb-7">Tous nos articles articles</h2>
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3 lg:gap-10">
        {# Card 01 #}
        <article class="group overflow-hidden rounded-2xl bg-base-100 shadow-sm ring-1 ring-base-300 transition hover:-translate-y-1 hover:shadow-xl">
            <figure class="relative overflow-hidden">
                <img
                    src="{{ asset('images/posts/1.jpg') }}"
                    alt="Développement web"
                    class="h-64 w-full object-cover transition duration-500 group-hover:scale-105">
                <span class="badge badge-primary absolute left-4 top-4 text-white">
                Développement
                    </span>
            </figure>
            <div class="p-6">
                <div class="flex items-center gap-2 text-sm text-base-content/50">
                    {{ ux_icon('lucide:calendar', {class: 'h-4 w-4'}) }}
                    <time datetime="2026-08-30">
                        30 août 2026
                    </time>
                </div>
                <h2 class="mt-3 text-2xl font-[600] tracking-tight">
                    Les nouvelles tendances du développement web
                </h2>
                <p class="mt-3 leading-relaxed text-base-content/70 line-clamp-3">
                    Découvrez les technologies et les bonnes pratiques qui
                    façonnent le développement web moderne.
                </p>
                <div class="mt-6">
                    <a
                        href="#"
                        class="btn btn-primary btn-sm text-white">
                        Lire l'article
                        {{ ux_icon('lucide:arrow-right', {class: 'h-4 w-4'}) }}
                    </a>
                </div>
            </div>
        </article>

